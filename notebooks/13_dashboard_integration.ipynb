    "# Skill gap analysis connection\n",
    "def display_skill_gap_analysis(candidate, filtered_jobs):\n",
    "    st.header(\"Skill Gap Analysis\")\n",
    "    \n",
    "    # Candidate skills\n",
    "    st.subheader(\"Your Skills\")\n",
    "    for skill in candidate['skills']:\n",
    "        st.write(f\"- {skill}\")\n",
    "    \n",
    "    # Market demanded skills\n",
    "    st.subheader(\"Market Demanded Skills\")\n",
    "    all_skills = []\n",
    "    for skills in filtered_jobs['Skills'].dropna():\n",
    "        all_skills.extend([s.strip() for s in str(skills).split(',')])\n",
    "    \n",
    "    skill_counts = pd.Series(all_skills).value_counts().head(15)\n",
    "    st.bar_chart(skill_counts)\n",
    "\n",
    "print(\"Skill gap analysis connected.\")"
   ]
  },
