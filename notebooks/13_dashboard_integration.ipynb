   "source": [
    "# Job recommendations connection\n",
    "def display_job_recommendations(filtered_jobs):\n",
    "    st.header(\"Recommended Jobs\")\n",
    "    \n",
    "    top_jobs = filtered_jobs.nlargest(5, 'match_score')\n",
    "    \n",
    "    for i, job in top_jobs.iterrows():\n",
    "        st.write(f\"**{i+1}. {job['Job_Title']} at {job['Company']}**\")\n",
    "        st.write(f\"   Location: {job['Province']} | Match: {job['match_score']:.1f}%\")\n",
    "        st.write(f\"   {job['match_explanation']}\")\n",
    "        st.write(\"\")\n",
    "\n",
    "print(\"Job recommendations connected.\")"
   ]
