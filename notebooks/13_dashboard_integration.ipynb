    "# Complete user flow\n",
    "def run_complete_flow():\n",
    "    # Create profile\n",
    "    profile = create_profile_interface()\n",
    "    \n",
    "    # Select target job\n",
    "    selected_job, filtered_jobs = create_target_job_interface(df)\n",
    "    \n",
    "    # Upload CV\n",
    "    uploaded_file = create_cv_upload_interface()\n",
    "    \n",
    "    # Parse CV if uploaded\n",
