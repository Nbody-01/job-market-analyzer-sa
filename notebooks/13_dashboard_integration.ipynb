   "source": [
    "# Market alignment connection\n",
    "def display_market_alignment(market):\n",
    "    st.header(\"Job Market Alignment\")\n",
    "    \n",
    "    # Overall score\n",
    "    score = market['market_alignment_score']\n",
    "    st.progress(score / 100)\n",
    "    st.write(f\"**Market Alignment Score: {score:.1f}%**\")\n",
    "    \n",
    "    # Skill gaps\n",
    "    st.subheader(\"Market Skill Gaps\")\n",
    "    gaps = market['skill_gaps'][:5]\n",
    "    for gap in gaps:\n",
    "        st.write(f\"- {gap['Skill']}: {gap['Demand %']:.1f}% demand\")\n",
    "    \n",
    "    # Priorities\n",
    "    st.subheader(\"Your Priorities\")\n",
    "    for i, priority in enumerate(market['priorities'], 1):\n",
    "        st.write(f\"{i}. {priority}\")\n",
    "\n",
    "print(\"Market alignment connected.\")"
   ]
  },
