    "\n",
    "# STEP 16 — Validate the Result\n",
    "\n",
    "## Purpose\n",
    "Verify the matching results are reasonable.\n",
    "\n",
    "## Method\n",
    "Check score ranges and component contributions."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Validation\n",
    "print(\"Validation Results:\")\n",
    "print(\"=\"*60)\n",
    "\n",
    "checks = {\n",
    "    'match_score_in_range': (df['match_score'] >= 0).all() and (df['match_score'] <= 100).all(),\n",
    "    'skill_match_in_range': (df['skill_match'] >= 0).all() and (df['skill_match'] <= 100).all(),\n",
    "    'education_match_in_range': (df['education_match'] >= 0).all() and (df['education_match'] <= 100).all(),\n",
    "    'experience_match_in_range': (df['experience_match'] >= 0).all() and (df['experience_match'] <= 100).all(),\n",
    "    'text_similarity_in_range': (df['text_similarity'] >= 0).all() and (df['text_similarity'] <= 100).all()\n",
    "}\n",
    "\n",
    "for check, result in checks.items():\n",
    "    status = 'PASS' if result else 'FAIL'\n",
    "    print(f\"  [{status}] {check}\")\n",
    "\n",
    "print(f\"\\nOverall: {'ALL CHECKS PASSED' if all(checks.values()) else 'SOME CHECKS FAILED'}\")"
   ]
  },
  {
